service BasicService : (void) -> void;
service PremiumService : (void) -> void;
service VipService : (void) -> void;

(b: bool, x: bool) => {
    if (b) {
        if (x) {
            call BasicService();
        } else {
            call PremiumService();
        }
    } else {
        call VipService();
    }
}

